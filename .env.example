# 後端（backend/src/main/resources/application-local.yml 會讀取這些值的預設）
DB_URL=jdbc:postgresql://localhost:5432/online_santa
DB_USERNAME=santa
DB_PASSWORD=santa

# Firebase（M3 之後才需要）
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Cloud Storage（M4 之後才需要）
GCS_BUCKET=online-santa-uploads

# 管理員白名單，逗號分隔
APP_ADMIN_EMAILS=you@example.com
