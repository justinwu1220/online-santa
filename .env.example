# 後端（backend/src/main/resources/application-local.yml 會讀取這些值的預設）
DB_URL=jdbc:postgresql://localhost:5432/online_santa
DB_USERNAME=santa
DB_PASSWORD=santa

# Firebase（M3 之後才需要）
FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Cloud Storage（M4 之後才需要）
GCS_BUCKET=online-santa-uploads

# 管理員白名單，逗號分隔。名單內的信箱「登入時」會取得 ADMIN 角色。
#
# 正式環境刻意留空——管理員直接由資料庫的 users.role 管理（見 docs/DEPLOY.md
# 「管理員的升降級」）。這個變數只在兩種時候派上用場：本機開發想快速取得
# 管理員身分，以及正式環境的資料庫裡一個管理員都不剩時的救援。
APP_ADMIN_EMAILS=you@example.com

# 願望示意圖上傳（預設關閉）。要開啟時前端的 VITE_WISH_IMAGE_ENABLED 也要一起設
WISH_IMAGE_ENABLED=
