# 留空則走 Vite dev server 的 proxy（見 vite.config.ts）
VITE_API_BASE_URL=

# Firebase Web SDK 設定（M3 之後才需要）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# 願望示意圖上傳。預設關閉，願望牆改用分類圖示；要在本機試這條路徑就設成 true，
# 後端也要一起設 WISH_IMAGE_ENABLED=true（見 docs/DEPLOY.md 第九節）
VITE_WISH_IMAGE_ENABLED=
