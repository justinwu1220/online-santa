# 留空則走 Vite dev server 的 proxy（見 vite.config.ts）。
# 正式環境也留空：前端與 API 同網域（Firebase Hosting 把 /api/** 轉給 Cloud Run），
# 登入狀態 cookie 才不會被瀏覽器當成第三方 cookie 擋掉（見 docs/DEPLOY.md）
VITE_API_BASE_URL=

# 開發模式：輸入任何 email 就能切換身分，沒有密碼也不寄信。
# 要同時啟用後端的 dev-auth profile（本機預設就有）。留空或 false 就是真正的帳號登入——
# 註冊會寄 6 位數驗證碼；沒設定 SMTP 時驗證碼與重設連結會印在後端的 log
VITE_DEV_AUTH=

# 環境名稱。設了之後每一頁頂端會出現醒目的黃黑橫幅，分頁標題也會加上 [名稱] 前綴。
# 測試站設「測試站」；正式站與本機一律留空（正式站不能有橫幅，部署流程會檢查）
VITE_ENV_LABEL=

# 願望示意圖上傳。預設關閉，願望牆改用分類圖示；要在本機試這條路徑就設成 true，
# 後端也要一起設 WISH_IMAGE_ENABLED=true（見 docs/DEPLOY.md 第九節）
VITE_WISH_IMAGE_ENABLED=
